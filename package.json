{
  "name": "dsh-tailscale-remote",
  "version": "0.1.0",
  "type": "module",
  "description": "Publishes the DSH Web GUI on your tailnet whenever DSH runs, so a phone anywhere can connect, and removes the route on exit. The login link lives in the loginUrl field of ~/.dsh/tailscale-remote.json (https://<machine>.<tailnet>.ts.net:7259/remote/<key>); bookmark it once — it survives restarts.",
  "license": "MIT",
  "author": "Ckarefulon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ckarefulon/dsh-tailscale-remote.git"
  },
  "homepage": "https://github.com/Ckarefulon/dsh-tailscale-remote#readme",
  "bugs": {
    "url": "https://github.com/Ckarefulon/dsh-tailscale-remote/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tailscale",
    "tailnet",
    "serve",
    "remote",
    "mobile",
    "phone",
    "remote-access"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node --test test/classify.test.mjs test/teardown.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
